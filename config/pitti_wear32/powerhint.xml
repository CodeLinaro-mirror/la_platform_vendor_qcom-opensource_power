<HintConfigs>
    <Powerhint>
        <!-- camera preview -->
        <!-- pitti_wear32: cores 4-7 (BIG cluster) offline, only LITTLE cores 0-3 active -->
        <!--L CPU CORE 0 SCHED LOAD BOOST -->
        <!--L CPU Hispeed freq of 1094Mhz -->
        <!--L CLUSTER_LITTLE - Set hispeed load 99 -->
        <!--CPUBW HWMON - Set sample_ms 48 -->
        <!--CPUBW HWMON - Set io_percent 100 -->
        <!--CPUBW HWMON - Set up_scale 0 -->
        <!-- AB scale 50 -->
        <!--L CPU max freq 1286Mhz -->
        <Config
            Id="0x00001330" Enable="true" Timeout="0" Target="pitti_wear32"
            Resources="0x40C68100, -15,
            0x4143C100, 1094, 0x41440100, 0x63, 0x43034000, 0x30, 0x43020000,
            0x64, 0x43014000, 0x0, 0x43048000, 0x32, 0x40804100, 1286"/>

        <!-- camera 30fps-->
        <!-- pitti_wear32: cores 4-7 (BIG cluster) offline, only LITTLE cores 0-3 active -->
        <!--L CPU CORE 0 SCHED LOAD BOOST -->
        <!--L CLUSTER_LITTLE - Set hispeed load 95 -->
        <!--CPUBW HWMON - Set sample_ms 48 -->
        <!--CPUBW HWMON - Set io_percent 100 -->
        <!--CPUBW HWMON - Set up_scale 0 -->
        <!--Set uclamp latency sensitivity to 1 -->
        <!-- AB scale 50-->
        <!--L CPU max freq 1286Mhz -->
        <Config
            Id="0x00001331" Enable="true" Timeout="0" Target="pitti_wear32"
            Resources="0x40C68100, -10,
            0x41440100, 0x5F, 0x43034000, 0x30, 0x43020000, 0x64, 0x43014000, 0x0,
            0x40CEC000, 0x1, 0x43048000, 0x32, 0x40804100, 1286"/>



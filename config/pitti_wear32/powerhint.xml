         <Config
             Id="0x00001206" Enable="true" Timeout="0" Target="pitti_wear32"
             Resources="0x40800000, 0x0, 0x40800100, 0x0, 0x40804000, 0x4CC, 0x40804100, 0x4CC,
             0X4280C000, 0x113, 0X42810000, 0x190, 0x42814000, 0x0"/>




            Resources="0x40C68100, -10,
            0x40800100, 1094, 0x43034000, 0x30, 0x43020000, 0x64, 0x43014000, 0x0, 0x41000100, 4,
            0x40CEC000, 0x1"/>

    </Powerhint>

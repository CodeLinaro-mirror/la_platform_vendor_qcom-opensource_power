            0x5F, 0x43034000, 0x14, 0x43048000, 0x32, 0x40804100, 1094"/>


        <!-- HFR 480fps -->
        <!-- pitti_wear32: cores 4-7 (BIG cluster) offline, only LITTLE cores 0-3 active -->
        <!--L CPU CORE 0 SCHED LOAD BOOST -->
        <!--L CPU Hispeed freq of 1094Mhz -->
        <!--L CLUSTER_LITTLE - Set hispeed load 95 -->
        <!--CPUBW HWMON - Set sample_ms 20 -->
        <!--L CPU core ctl min cpus 4 -->
        <Config
            Id="0x00001334" Enable="true" Timeout="0" Target="pitti_wear32"
            Resources="0x40C68100, 0xFFFFFFFA, 0x4143C100, 1094, 0x41440100,
            0x5F, 0x43034000, 0x14, 0x41000100, 4"/>



